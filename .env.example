# Copy to .env and fill in. .env is in .gitignore, never commit it.

# NCBI asks for a contact email so they can reach you instead of blocking you.
NCBI_EMAIL=
# Optional: raises the limit from 3 to 10 requests/second.
# Free: https://www.ncbi.nlm.nih.gov/account/ -> Account settings -> API Key Management
NCBI_API_KEY=

# Local database from docker-compose. In production: the Neon/Supabase connection string.
DATABASE_URL=postgresql://neurolit:neurolit@localhost:5433/neurolit

# Only needed if an old/invalid Hugging Face token is saved on this machine (gives 401 on public models).
# HF_HUB_DISABLE_IMPLICIT_TOKEN=1

# LLM provider: groq (default) or ollama
LLM_PROVIDER=groq
# Free key: https://console.groq.com -> API Keys
GROQ_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=openai/gpt-oss-120b
